        <script><![CDATA[(function() {
    /* Server script to handle fetching the poster URL based on the 'question_filme' parameter */


    data.uName = gs.getUserDisplayName(); // Get the user's display name


		
    // Check if input.sysid exists and fetch the corresponding record
    if (input && input.sysid) {
        var gr = new GlideRecord("x_1488662_film_r_0_filmes");
        if (gr.get(input.sysid)) { // Fetch the record with the given sys_id
            data.posterurl = gr.getValue("posterurl"); // Get the poster URL
    				data.avgNota = gr.getValue('nota_media');
				}
    }
		
})();
]]></script>
