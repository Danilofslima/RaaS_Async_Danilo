<?xml version="1.0" encoding="UTF-8"?><record_update table="sp_widget">
    <sp_widget action="DELETE">
        <category>custom</category>
        <client_script><![CDATA[api.controller = function($scope) {
    /* widget controller */
    var c = this;
    
    // Watch for changes in the 'question_filme' field
    $scope.$watch(function() {
        return $scope.page.g_form.getValue('question_filme');
    }, function(newValue, oldValue) {
        if (newValue !== oldValue) {
            c.sendData(newValue);
        }
    });


    // Function to send data to the server and update the poster URL
    c.sendData = function(filmeSysId) {
        c.data.sysid = filmeSysId; // Set the selected 'filme' sys_id to send to the server
        c.server.update().then(function(response) {
            c.data.posterurl = response.data.posterurl; // Update the poster URL with the response from the server
        });
    };
};
]]></client_script>
